@model ERP.Infrastructure.ViewModels.ProductFilterVM

@{
    ViewData["Title"] = "Products";
}

<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

<link href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" rel="stylesheet" />

<style>
    body {
        background-color: #f8fbff;
    }

    h2 {
        color: #0d6efd;
        font-weight: 700;
        text-align: center;
        margin-bottom: 25px;
        letter-spacing: 0.4px;
    }

    .card {
        background: #ffffff;
        border: none;
        border-radius: 20px;
        box-shadow: 0 4px 15px rgba(13, 110, 253, 0.15);
        padding: 25px;
    }

    .form-control,
    .form-select,
    .select2-container--default .select2-selection--single {
        border-radius: 15px;
        border: 1px solid #cfe2ff;
        height: 38px;
        transition: 0.3s ease;
    }

        .form-control:focus,
        .form-select:focus,
        .select2-selection--single:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 6px rgba(13, 110, 253, 0.3);
        }

    table.dataTable {
        border-radius: 15px;
        overflow: hidden;
        background-color: #ffffff;
    }

        table.dataTable thead th {
            background-color: #0d6efd;
            color: #ffffff;
            text-align: center;
            font-weight: 600;
            font-size: 15px;
            border: none;
        }

        table.dataTable tbody td {
            text-align: center;
            vertical-align: middle;
            font-size: 14px;
            color: #333333;
            padding: 10px;
        }

        table.dataTable tbody tr:hover {
            background-color: #eaf2ff !important;
            transition: background-color 0.3s ease;
        }


    .dataTables_wrapper .dataTables_paginate .paginate_button {
        border-radius: 10px !important;
        background-color: #f0f8ff !important;
        color: #0d6efd !important;
        border: none !important;
        margin: 0 3px;
        padding: 6px 12px;
    }

        .dataTables_wrapper .dataTables_paginate .paginate_button.current {
            background-color: #0d6efd !important;
            color: #ffffff !important;
            font-weight: 600;
        }

    .dataTables_wrapper .dataTables_info {
        color: #6c757d;
        margin-top: 10px;
    }

    .row.g-3.mb-4 {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 15px;
    }

    .col-md-4, .col-md-3 {
        flex: 1;
    }
</style>

<h2>Products</h2>

<div class="card shadow-sm">
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <input type="text" id="NameSearch" class="form-control" placeholder="Search by Name" value="@Model.NameSearch" />
        </div>

        <div class="col-md-3">
            <select id="CategoryId" class="form-select">
                <option value="">All Categories</option>
                @foreach (var cat in Model.Categories)
                {
                    <option value="@cat.Value" selected="@(Model.CategoryId?.ToString() == cat.Value)">
                        @cat.Text
                    </option>
                }
            </select>
        </div>

        <div class="col-md-3">
            <select id="BranchId" class="form-select">
                <option value="">All Branches</option>
                @foreach (var branch in Model.Branches)
                {
                    <option value="@branch.Value" selected="@(Model.BranchId?.ToString() == branch.Value)">
                        @branch.Text
                    </option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <select id="UnitId" class="form-select">
                <option value="">All Units</option>
                @foreach (var Unit in Model.Units)
                {
                    <option value="@Unit.Value" selected="@(Model.UnitId?.ToString() == Unit.Value)">
                        @Unit.Text
                    </option>
                }
            </select>
        </div>
    </div>

    <table id="js-ProductsTable" class="table table-bordered table-hover align-middle text-center">
        <thead class="table-primary">
            <tr>
                <th>Id</th>
                <th>Product Name</th>
                <th>Category</th>
                <th>Unit</th>
                <th>Branch</th>
                <th>Price</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="~/js/product.js"></script>
}
